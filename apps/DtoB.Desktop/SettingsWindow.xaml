<Window x:Class="DtoB.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DtoB Settings" Width="620" Height="370" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <StackPanel Margin="24"><TextBlock Text="Working Directory"/><TextBox x:Name="Working" Margin="0,4,0,12"/><TextBlock Text="Cache Directory"/><TextBox x:Name="Cache" Margin="0,4,0,12"/><TextBlock Text="Revit Target"/><ComboBox x:Name="Target" Margin="0,4,0,12"><ComboBoxItem Content="2025" IsSelected="True"/></ComboBox><TextBlock Text="Log Level"/><ComboBox x:Name="Level" Margin="0,4,0,16"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Save Settings" Click="Save_Click" Padding="16,8" IsDefault="True"/><Button Content="Cancel" IsCancel="True" Padding="16,8" Margin="8,0,0,0"/></StackPanel></StackPanel>
</Window>
