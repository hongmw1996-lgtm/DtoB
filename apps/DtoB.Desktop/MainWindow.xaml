<Window x:Class="DtoB.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding WindowTitle}" Width="920" Height="620" MinWidth="720" MinHeight="500">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="DtoB · Drawing to BIM" FontSize="26" Margin="0,0,0,18"/>
   <WrapPanel>
    <Button Content="New Project" Click="New_Click" Padding="14,8" Margin="0,0,8,0"/>
    <Button Content="Open Project" Click="Open_Click" Padding="14,8" Margin="0,0,8,0"/>
    <Button Content="Save" Click="Save_Click" IsEnabled="{Binding HasProject}" Padding="14,8" Margin="0,0,8,0"/>
    <Button Content="Save As" Click="SaveAs_Click" IsEnabled="{Binding HasProject}" Padding="14,8" Margin="0,0,8,0"/>
    <Button Content="Close Project" Click="Close_Click" IsEnabled="{Binding HasProject}" Padding="14,8" Margin="0,0,8,0"/>
    <Button Content="Settings" Click="Settings_Click" Padding="14,8" Margin="0,0,8,0"/>
    <Button Content="Connection Verification" Click="Connection_Click" Padding="14,8"/>
   </WrapPanel>
  </StackPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Text="Ready" TextWrapping="Wrap" Margin="0,18,0,0"/>
  <Grid Margin="0,24,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal"><TextBlock Text="Project name" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="NameInput" Width="350" IsEnabled="{Binding HasProject}" Text="{Binding ProjectName,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True}" AutomationProperties.AutomationId="ProjectName"/></StackPanel>
   <TextBlock Grid.Row="1" Text="{Binding Metadata}" Margin="0,16,0,24" TextWrapping="Wrap" AutomationProperties.AutomationId="ProjectMetadata"/>
   <TextBlock Grid.Row="2" Text="Recent Projects" FontSize="18" Margin="0,0,0,10"/>
   <ListBox Grid.Row="3" x:Name="RecentList" DisplayMemberPath="Display" MouseDoubleClick="Recent_DoubleClick" KeyDown="Recent_KeyDown" AutomationProperties.AutomationId="RecentProjects"/>
  </Grid>
 </DockPanel>
</Window>
