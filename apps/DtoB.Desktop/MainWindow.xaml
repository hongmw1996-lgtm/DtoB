<Window x:Class="DtoB.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DtoB — PHASE 00 Connection Verification" Width="680" Height="340">
  <StackPanel Margin="24">
    <TextBlock Text="DtoB · Revit connection verification" FontSize="22" Margin="0,0,0,16" />
    <TextBlock Text="Enter the Revit process ID (PID), then send PING." />
    <TextBox x:Name="ProcessId" Margin="0,8,0,12" AutomationProperties.AutomationId="RevitProcessId" />
    <Button x:Name="PingButton" Content="PING Revit" Click="Ping_Click" HorizontalAlignment="Left" Padding="20,8" />
    <TextBlock x:Name="ConnectionStatus" Text="Disconnected · no PING sent" Margin="0,16,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionStatus" />
    <TextBlock Text="Technical verification only · no drawing parsing or BIM generation" Margin="0,16,0,0" Foreground="Gray" />
  </StackPanel>
</Window>
