<Window x:Class="DtoB.Desktop.DiagnosticViewerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="clr-namespace:DtoB.Desktop.Diagnostics" Title="DtoB · Raw DXF Diagnostic Viewer" Width="1320" Height="900" MinWidth="1000" MinHeight="700">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top">
   <WrapPanel Margin="0,0,0,8">
    <Button x:Name="RunButton" Content="Run / Refresh Extraction" Click="Run_Click" Padding="9,6"/>
    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" Padding="9,6"/>
    <Button Content="Entities" Click="Entities_Click" Padding="9,6" Margin="12,0,0,0"/>
    <ComboBox x:Name="Blocks" Width="210" SelectionChanged="Block_Changed" Margin="6,0" ToolTip="Raw block definition; never an occurrence"/>
    <Button Content="Fit" Click="Fit_Click" Padding="9,6"/><Button Content="Reset View" Click="Reset_Click" Padding="9,6"/>
   </WrapPanel>
   <TextBlock x:Name="State" Text="Select Run to extract managed Text DXF." TextWrapping="Wrap" AutomationProperties.AutomationId="ExtractionStatus"/>
   <TextBlock x:Name="Summary" TextWrapping="Wrap" FontSize="12" Margin="0,5" AutomationProperties.AutomationId="ExtractionSummary"/>
   <TextBlock x:Name="ModeNotice" TextWrapping="Wrap" Foreground="DarkSlateBlue" Margin="0,0,0,8"/>
  </StackPanel>
  <Expander DockPanel.Dock="Bottom" Header="Stage diagnostics — historical diagnostics; effective disposition comes from Snapshot summary" IsExpanded="True" Margin="0,8,0,0">
   <DataGrid x:Name="Diagnostics" Height="130" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
    <DataGrid.Columns><DataGridTextColumn Header="Stage" Binding="{Binding Stage}"/><DataGridTextColumn Header="Code" Binding="{Binding Code}"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="220"/><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/></DataGrid.Columns>
   </DataGrid>
  </Expander>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="470"/></Grid.ColumnDefinitions>
   <Grid Background="WhiteSmoke"><d:DiagnosticViewport x:Name="Viewport"/><TextBlock x:Name="EmptyState" Text="No successful extraction. No scene published." IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="CameraStatus" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Background="#DFFFFFFF"/></Grid>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
   <Grid Grid.Column="2" Margin="8,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="All source records · includes Unsupported and unrendered records" TextWrapping="Wrap"/>
    <ListBox x:Name="Records" Grid.Row="1" SelectionChanged="Record_Changed" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.AutomationId="RawRecords"/>
    <TextBox x:Name="Inspector" Grid.Row="2" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0" AutomationProperties.AutomationId="SourceInspector"/>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
